# Firebase Web App config (Firebase Console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
# Optional: enable Google Analytics in Firebase Console, then paste Measurement ID
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXX

# Launch feedback (Google Form / Typeform URL preferred)
# VITE_FEEDBACK_URL=https://forms.gle/your-form-id
# Or fall back to mailto on /feedback:
# VITE_FEEDBACK_EMAIL=you@example.com
